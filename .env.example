# Copy to your hosting environment. Never commit real credentials.
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
REDIS_URL=redis://localhost:6379/0
POSTGRES_MIN_POOL_SIZE=1
POSTGRES_MAX_POOL_SIZE=10
CACHE_TTL=900
NEWS_CACHE_TTL=300
NEWS_SYNC_INTERVAL=86400
AUTH_TOKEN_TTL_DAYS=30
USER_RETENTION_DAYS=90
SCHEDULE_RETENTION_DAYS=90
UNIO_LOG_LEVEL=INFO

# Optional PWA portal bridge; keep encryption keys stable across deployments.
WEB_PORTAL_KEYS=
WEB_PORTAL_ORIGINS=https://your-pwa.example
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:unio.support@gmail.com

# Optional document assistant. Quotas are enabled in this example.
AI_ENABLED=false
AI_TEST_MODE=false
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
AI_MAX_OUTPUT_TOKENS=900
AI_CONTEXT_CHARS=8000
AI_USER_DAILY_REQUESTS=20
AI_DAILY_TOKEN_BUDGET=200000
AI_MONTHLY_TOKEN_BUDGET=3000000
AI_MAX_CONCURRENT=2

# Test mode relaxes per-user quotas; global AI day/month budgets remain enforced.

# Optional: only needed for manual POST /api/v1/news/sync; background sync needs no token.
ADMIN_SYNC_TOKEN=
